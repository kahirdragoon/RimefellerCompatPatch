<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BasedRimefellerMom">
    <defName>RF_ChemfuelCanister</defName>
    <label>chemfuel canister</label>
    <graphicData>
      <texPath>Canister/Canister_C</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
      <drawRotated>false</drawRotated>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <description>A large tank that can store liquid chemfuel.</description>
    <researchPrerequisites>
      <li>ChemfuelRefining</li>
    </researchPrerequisites>
    <fillPercent>0.2</fillPercent>
    <uiIconPath>Canister/Canister_C_UI</uiIconPath>
    <uiIconScale>1</uiIconScale>
    <size>(3,2)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>ItemImportant</altitudeLayer>
    <statBases>
      <Beauty>0.7</Beauty>
      <MaxHitPoints>950</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>120</Mass>
    </statBases>
    <costList>
      <Steel>200</Steel>
    </costList>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>9</maxItemsInCell>
    </building>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>Oil</li>
    </thingCategories>
    <comps>
      <li Class="Rimefeller.CompProperties_StorageTank">
        <StorageCap>7500</StorageCap>
        <Contents>Fuel</Contents>
      </li>
      <li Class="CompProperties_Explosive">
        <compClass>Rimefeller.CompExplosiveTank</compClass>
        <explosiveRadius>15</explosiveRadius>
        <explosiveDamageType>Flame</explosiveDamageType>
        <destroyThingOnExplosionSize>4</destroyThingOnExplosionSize>
        <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
        <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
        <preExplosionSpawnChance>1</preExplosionSpawnChance>
        <wickTicks>
          <min>120</min>
          <max>250</max>
        </wickTicks>
      </li>
    </comps>
  </ThingDef>
</Defs>